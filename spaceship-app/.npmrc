# Keep installs reproducible and save future dependencies as exact versions.
package-lock=true
lockfile-version=3
save-exact=true

# Enforce the declared runtime and reject conflicting peer dependencies.
engine-strict=true
strict-peer-deps=true

# Block install lifecycle scripts; review version-specific allowScripts decisions.
# package.json requires npm >=11.20 for strict script-policy support.
ignore-scripts=true
strict-allow-scripts=true

# Require new dependency resolutions to be at least two days old.
min-release-age=2

# Verify registry TLS certificates.
strict-ssl=true

# Keep installer output quiet and registry requests bounded.
fund=false
update-notifier=false
fetch-retries=5
fetch-timeout=60000
